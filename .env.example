# --- Base de datos ---
DATABASE_URL=postgres://tarasca_admin:tarasca_password@localhost:5432/tarascapay_db

# --- Servidor ---
HOST=127.0.0.1
PORT=3000

# --- Autenticación ---
# Obligatorio en producción. Mínimo 16 caracteres.
# Si no se define, se genera uno efímero y las sesiones caen en cada reinicio.
JWT_SECRET=cambiame-por-un-secreto-largo-y-aleatorio
# Duración de la sesión en horas (por defecto 720 = 30 días).
JWT_TTL_HOURS=720

# --- Comprobantes ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=10485760

# --- CORS ---
# Orígenes del frontend separados por coma. '*' permite cualquiera (sólo dev).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend embebido (opcional) ---
# Si apunta al build del SPA, la misma API lo sirve y no hace falta CORS.
# WEB_DIST=./web/dist

# --- Logs ---
RUST_LOG=api=info,tower_http=info,sqlx=warn
